{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ScreenHelper: Run",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/android.ps1",
        "-Task",
        "Run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "ScreenHelper: Build APK",
      "type": "process",
